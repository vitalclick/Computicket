<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Computicket</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>computicket_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!--
	  Camera permission for the in-app scanner (apps/mobile/lib/screens/
	  scanner_screen.dart). iOS shows this prompt the first time the
	  camera is requested; without the key the OS hard-refuses access.
	-->
	<key>NSCameraUsageDescription</key>
	<string>Used to scan ticket QR codes at the gate. Computicket only uses the camera while the Scan Tickets screen is open.</string>
	<!--
	  Export compliance. We use TLS but no custom encryption — Apple's
	  pre-approved exemption applies. Declaring `false` here skips the
	  Export Compliance prompt on every App Store Connect upload. If
	  you ever add end-to-end encryption beyond TLS, flip to `true`
	  and complete the annual self-classification with the BIS.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  Universal links. The web app serves the matching AASA at
	  /.well-known/apple-app-site-association — set IOS_APP_TEAM_ID on
	  Vercel to thread the real team ID in. Without that env var, the
	  AASA still returns 200 but with a placeholder appID that won't
	  match anything iOS verifies.
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>tel</string>
		<string>mailto</string>
	</array>
</dict>
</plist>
