# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock

# Platform shells are generated by `flutter create .` on first checkout.
# Keeping them out of source control so the upstream Flutter SDK can
# bump them without polluting our diff — *except* for the two
# permission-bearing manifests we maintain by hand. `flutter create
# --no-overwrite` leaves existing files alone, so checking these in
# pins our camera + internet permission declarations and survives
# every regeneration.
ios/*
!ios/Runner/
ios/Runner/*
!ios/Runner/Info.plist
!ios/Runner/Runner.entitlements
!ios/Runner/PrivacyInfo.xcprivacy
android/*
!android/app/
!android/settings.gradle
android/app/*
!android/app/build.gradle
!android/app/proguard-rules.pro
!android/app/src/
android/app/src/*
!android/app/src/main/
android/app/src/main/*
!android/app/src/main/AndroidManifest.xml
web/
linux/
macos/
windows/

# Per-project secrets — Codemagic injects these at build time.
ios/Runner/GoogleService-Info.plist
android/app/google-services.json
android/key.properties
android/app/*.jks
android/app/*.keystore

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
